# Copy to .env at the repo root (never commit .env)

# Meta Model API key (dev.meta.ai)
MODEL_API_KEY=

# Prompt agent: Muse Spark picks the SAM search words.
# With BASETEN_API_KEY set, Muse Spark Open (open weights) on Baseten is used;
# otherwise Muse Spark 1.3 on Meta Model API (MODEL_API_KEY).
BASETEN_API_KEY=

# --- optional ---
# PROMPT_STRATEGY=agent
# LLM_PROVIDER=baseten
# LLM_MODEL=meta-models/muse-spark-open-1026
# LLM_REASONING_EFFORT=low
# LLM token prices in USD per 1M tokens, for cost reports (Baseten's price is not in their docs):
# LLM_PRICE_IN_PER_M=
# LLM_PRICE_OUT_PER_M=
# META_API_BASE=https://api.meta.ai/v1
# SAM_MODEL=sam-3.1
# SCORE_THRESHOLD=0.5
# ENABLE_LESION=1       # 0 = no SAM 'leaf spot' search (lesion share then from color only)
# REPORT_AGENT=1        # 0 = report texts from templates, no LLM
# SAM_BACKEND=meta      # "offline" = color-based dev segmenter, NOT SAM (local UI work without a key)

# --- production (Supabase) ---
# Postgres: Project Settings → Database → Connect → "Session pooler" URI (works over IPv4, e.g. from Modal).
# The API creates its tables (plots, analyses, notes, users, auth_sessions) on start and enables RLS on them.
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=                  # Project Settings → API → service_role key (server only, never in the web app)
# SUPABASE_BUCKET=images                 # Storage → New bucket "images", set to Public
# CORS_ORIGINS=https://your-app.vercel.app

# Copy to .env at the repo root (never commit .env)

# Meta Model API key (dev.meta.ai)
MODEL_API_KEY=

# Prompt agent: Muse Spark picks the SAM search words.
# With BASETEN_API_KEY set, Muse Spark Open (open weights) on Baseten is used;
# otherwise Muse Spark 1.3 on Meta Model API (MODEL_API_KEY).
BASETEN_API_KEY=

# --- optional ---
# PROMPT_STRATEGY=agent
# LLM_PROVIDER=baseten
# LLM_MODEL=meta-models/muse-spark-open-1026
# LLM_REASONING_EFFORT=low
# LLM token prices in USD per 1M tokens, for cost reports (Baseten's price is not in their docs):
# LLM_PRICE_IN_PER_M=
# LLM_PRICE_OUT_PER_M=
# META_API_BASE=https://api.meta.ai/v1
# SAM_MODEL=sam-3.1
# SCORE_THRESHOLD=0.5
# ENABLE_LESION=0
# ENABLE_SUMMARY=1          # Muse Spark writes the plain-language summary (checked by the validator)
# SAM_BACKEND=meta          # "offline" = color-based dev segmenter, NOT SAM (local UI work without a key)
# VIDEO_FPS=2               # row video: frames sent to SAM per second
# VIDEO_MAX_FRAMES=40

# --- production (Supabase) ---
# DATABASE_URL=postgresql://postgres:...@...supabase.com:5432/postgres
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=images
# CORS_ORIGINS=https://your-app.vercel.app
